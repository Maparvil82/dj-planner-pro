{
  "expo": {
    "name": "DJ Planner PRO",
    "slug": "dj-planner-pro",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "djplannerpro",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.djplannerpro.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "DJ Planner necesita la cámara para escanear entradas QR y tomar fotos de facturas, carteles y perfiles.",
        "NSPhotoLibraryUsageDescription": "DJ Planner necesita acceso a tus fotos para añadir facturas, carteles y fotos de perfil."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "package": "com.djplannerpro.app",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      "expo-localization",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "DJ Planner necesita la cámara para escanear entradas QR y tomar fotos de facturas, carteles y perfiles.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "DJ Planner necesita la cámara para escanear entradas QR y tomar fotos de facturas, carteles y perfiles.",
          "photosPermission": "DJ Planner necesita acceso a tus fotos para añadir facturas, carteles y fotos de perfil.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "03382504-5cac-4497-a9cb-6f13cfee2e36"
      }
    }
  }
}
