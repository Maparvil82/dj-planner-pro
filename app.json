{
  "expo": {
    "name": "DJ Planner",
    "slug": "dj-planner-pro",
    "version": "1.0.6",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "djplannerpro",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.djplannerpro.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleLocalizations": [
          "es",
          "en",
          "de",
          "fr",
          "it",
          "pt-BR",
          "ja"
        ],
        "NSCameraUsageDescription": "DJ Planner necesita la cámara para escanear entradas QR y tomar fotos de facturas, carteles y perfiles.",
        "NSPhotoLibraryUsageDescription": "DJ Planner necesita acceso a tus fotos para añadir facturas, carteles y fotos de perfil."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#171717",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "package": "com.djplannerpro.app",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-localization",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#171717"
        }
      ],
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "DJ Planner necesita la cámara para escanear entradas QR y tomar fotos de facturas, carteles y perfiles.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "DJ Planner necesita la cámara para escanear entradas QR y tomar fotos de facturas, carteles y perfiles.",
          "photosPermission": "DJ Planner necesita acceso a tus fotos para añadir facturas, carteles y fotos de perfil.",
          "microphonePermission": false
        }
      ],
      "expo-mail-composer",
      [
        "expo-audio",
        {
          "microphonePermission": "DJ Planner necesita el micrófono para grabar tus notas de voz de hasta 20 segundos.",
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "03382504-5cac-4497-a9cb-6f13cfee2e36"
      }
    }
  }
}
